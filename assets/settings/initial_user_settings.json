// Vela settings
//
// For information on how to configure Vela, see the Vela
// documentation: https://vela.dev/docs/configuring-vela
//
// To see all of Vela's default settings without changing your
// custom settings, run `vela: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
    "starts_open": true,
  },
  "agent": {
    "dock": "right",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
